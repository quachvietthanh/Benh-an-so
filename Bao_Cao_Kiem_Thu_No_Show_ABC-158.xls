   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-NS-01</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Kiểm tra ngưỡng 15 phút không đến</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Unit Test (Backend &amp; Frontend)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentServiceTest.appliesNoShowThresholdAtExactBoundary</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Lịch 09:00. Kiểm tra lúc 09:14:59.999 và 09:15:00</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Trước 15p: False (Chưa quá hạn). Từ 15p: True (Quá hạn)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Xác nhận quá hạn đúng tại mốc 15 phút chính xác</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-155</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-NS-02</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Đánh dấu lịch quá hạn thành NO_SHOW</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Integration / Service Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentServiceTest.marksOverdueScheduledAppointmentAsNoShow</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Lịch SCHEDULED quá 16 phút. Gọi API /no-show</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Chuyển sang NO_SHOW; cập nhật updatedAt; lưu CSDL</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Chuyển trạng thái NO_SHOW và lưu DB thành công</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-156</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-NS-03</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Từ chối đánh dấu NO_SHOW trước 15 phút</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Service / API Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentServiceTest.rejectsNoShowBeforeThreshold</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Lịch SCHEDULED mới quá 14 phút. Gọi API /no-show</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Trả về HTTP 409 Conflict; không thay đổi dữ liệu</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Bị từ chối với HTTP 409 Conflict chuẩn xác</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-156</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-NS-04</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Từ chối NO_SHOW cho lịch không ở SCHEDULED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Parameterized Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentServiceTest.rejectsNoShowForNonScheduledStatuses</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Lịch ở trạng thái CHECKED_IN, COMPLETED, CANCELLED</Data></Cell>
