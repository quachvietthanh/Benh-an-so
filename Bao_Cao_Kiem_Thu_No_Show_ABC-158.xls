    <Cell ss:StyleID="CellData"><Data ss:Type="String">Bảo vệ trạng thái và trả về 409 Conflict chuẩn</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-157</Data></Cell>
