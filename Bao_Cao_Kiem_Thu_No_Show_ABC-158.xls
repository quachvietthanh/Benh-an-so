   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-NS-05</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Kiểm tra lịch hẹn không tồn tại (404)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Service / API Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentServiceTest.rejectsNoShowForUnknownAppointment</Data></Cell>
