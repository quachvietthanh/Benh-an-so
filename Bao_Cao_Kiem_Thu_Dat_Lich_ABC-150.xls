<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Author>Bệnh Án Số System</Author>
  <Title>Báo Cáo Kiểm Thử Đặt Lịch Hẹn ABC-150</Title>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#000000"/>
  </Style>
  <Style ss:ID="Header">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#1F4E78" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
   </Borders>
  </Style>
  <Style ss:ID="CellData">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
  </Style>
  <Style ss:ID="CellCenter">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
  </Style>
  <Style ss:ID="Passed">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#006100"/>
   <Interior ss:Color="#C6EFCE" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
  </Style>
 </Styles>
 <Worksheet ss:Name="Kiểm Thử Đặt Lịch ABC-150">
  <Table ss:DefaultRowHeight="24">
   <Column ss:Width="90"/>
   <Column ss:Width="220"/>
   <Column ss:Width="160"/>
   <Column ss:Width="260"/>
   <Column ss:Width="220"/>
   <Column ss:Width="240"/>
   <Column ss:Width="240"/>
   <Column ss:Width="90"/>
   <Column ss:Width="130"/>

   <Row ss:Height="30">
    <Cell ss:StyleID="Header"><Data ss:Type="String">Mã Test Case</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Tên Test Case</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Phân Loại Test</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Hàm Test / Module</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Điều Kiện Đầu Vào</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Kết Quả Mong Đợi</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Kết Quả Thực Tế</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Trạng Thái</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Ghi Chú</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-BK-01</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Đặt lịch hẹn khám bệnh thành công</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Integration Test / Service Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentService.create</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">patientId active, doctorId active, appointmentAt trong tương lai</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Tạo lịch thành công, sinh mã LH-XXXXXXXXXXXX, status = SCHEDULED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Tạo lịch thành công, trả về HTTP 200/201 và lưu CSDL</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-150</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-BK-02</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Kiểm tra định dạng Mã Lịch Hẹn ngẫu nhiên</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Unit Test (Backend)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentServiceTest.generatesUnpredictableLookupCodes</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Hàm newAppointmentCode() sinh mã</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Mã bắt đầu bằng LH-, nối tiếp 12 ký tự Hex, ngẫu nhiên không trùng</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Khớp Regex ^LH-[A-F0-9]{12}$ và không trùng lặp</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-150</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-BK-03</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Từ chối đặt trùng khung giờ bác sĩ (30 phút)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Business Logic / Conflict Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentService.create (Conflict check)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Bác sĩ A có lịch 09:00. Đặt tiếp lịch khác cho Bác sĩ A trong khoảng +-29 phút</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Báo lỗi HTTP 409 Conflict: Bác sĩ đã có lịch trong khung giờ này</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Bắn ngoại lệ HTTP 409 Conflict chuẩn xác</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-150</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-BK-04</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Từ chối Bệnh nhân không tồn tại / ngưng hoạt động</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Validation Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentService.create (Patient check)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">patientId sai hoặc bệnh nhân có active = false</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Báo lỗi HTTP 400 Bad Request: Hồ sơ bệnh nhân không tồn tại...</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Trả về 400 Bad Request chính xác</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-150</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-BK-05</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Từ chối Bác sĩ không tồn tại / ngưng hoạt động</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Validation Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentService.create (Doctor check)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">doctorId sai hoặc tài khoản bác sĩ active = false</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Báo lỗi HTTP 400 Bad Request: Bác sĩ không tồn tại...</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Trả về 400 Bad Request chính xác</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-150</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-BK-06</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Kiểm tra Validation thời gian trong quá khứ (@Future)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Spring Validation Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">AppointmentRequest.appointmentAt</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">appointmentAt là thời gian trong quá khứ</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Constraint Validation bắt lỗi và trả về HTTP 400 Bad Request</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Bắt lỗi Validation thành công</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-150</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-BK-07</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Phân quyền thao tác tạo lịch hẹn (APPOINTMENT_CREATE)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Security Authorization Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">PermissionEvaluator &amp; SecurityConfig</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Tài khoản có/không có quyền APPOINTMENT_CREATE</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Admin/Lễ tân được tạo. Vai trò không đủ quyền nhận 403 Forbidden</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Phân quyền chính xác chuẩn Security Matrix</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-150</Data></Cell>
   </Row>

   <Row ss:Height="26">
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">TC-BK-08</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Tra cứu công khai thông tin lịch hẹn (Public Lookup)</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Public API Contract Test</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">PublicAppointmentLookupControllerTest</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Tra cứu theo mã LH-XXXXXXXXXXXX + Ngày sinh</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Trả về hợp đồng JSON tối giản, tắt Caching; 404 nếu sai mã/ngày sinh</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Trả về hợp đồng JSON chuẩn xác, bảo mật dữ liệu</Data></Cell>
    <Cell ss:StyleID="Passed"><Data ss:Type="String">PASSED</Data></Cell>
    <Cell ss:StyleID="CellData"><Data ss:Type="String">Nghiệm thu ABC-150</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
</Workbook>
