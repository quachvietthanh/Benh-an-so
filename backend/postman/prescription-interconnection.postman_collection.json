{
  "info": {
    "name": "Benh So An - Prescription Interconnection",
    "_postman_id": "c52478bf-2e67-4ce6-b7b3-113334a0a4cb",
    "description": "Doctor sends a prescription; admin searches and retries failed submissions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "seededPassword", "value": "password" },
    { "key": "doctorAccessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "prescriptionId", "value": "" }
  ],
  "item": [
    {
      "name": "Login doctor",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"doctor1\",\n  \"password\": \"{{seededPassword}}\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
        "pm.collectionVariables.set('doctorAccessToken', pm.response.json().accessToken);"
      ]}}]
    },
    {
      "name": "Send prescription as responsible doctor",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{doctorAccessToken}}" }],
        "url": "{{baseUrl}}/prescriptions/{{prescriptionId}}/interconnection"
      }
    },
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{seededPassword}}\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
        "pm.collectionVariables.set('adminAccessToken', pm.response.json().accessToken);"
      ]}}]
    },
    {
      "name": "Search failed submissions as admin",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
        "url": "{{baseUrl}}/prescription-interconnections?status=FAILED&page=0&size=20"
      }
    },
    {
      "name": "Retry failed submission as admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
        "url": "{{baseUrl}}/prescriptions/{{prescriptionId}}/interconnection/retry"
      }
    }
  ]
}
